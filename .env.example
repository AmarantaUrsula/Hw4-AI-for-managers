# Copy this file to .env (in hw4/, next to this file) and fill in your own values.
# .env is gitignored — never commit a real key.

# Portkey gateway key used by the PydanticAI agent (backend/agent.py)
PORTKEY_API_KEY=your-portkey-api-key-here

# Model routed through Portkey (the agent was built and tested with gpt-6-luna)
PORTKEY_MODEL=gpt-6-luna

# Portkey OpenAI-compatible endpoint
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Hide PydanticAI's startup banner
PYDANTIC_AI_NO_BANNER=1
